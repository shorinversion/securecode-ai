# SecureCode AI v1.0 release-candidate configuration template
# Copy this file to .env and replace only the values needed by your deployment.
# The application does not load .env automatically. Export the variables in the
# shell or inject them through your service/container manager.

# Local CLI profile selection. Provider endpoints, models, capabilities and
# budgets are defined by an approved host-owned profile, not by these variables.
SECURECODE_PROVIDER_PROFILE=local-source-model@1.0.0
SECURECODE_POLICY_PROFILE=private-model-source
SECURECODE_EGRESS_PROFILE=private_model_zdr

# Local repair and validation
SECURECODE_AI_ARTIFACT_ROOT=.securecode/artifacts
SECURECODE_AI_VALIDATION_IMAGE=securecode-ai/repair-validator:local
# SECURECODE_AI_DOCKER_EXECUTABLE=/usr/bin/docker
# SECURECODE_AI_DOCKER_EXECUTABLE_SHA256=<sha256-of-docker-client>

# Control plane
SECURECODE_SERVER_HOST=127.0.0.1
SECURECODE_SERVER_PORT=8080
SECURECODE_DATA_DIR=/var/lib/securecode
SECURECODE_TMP_DIR=/tmp/securecode
# Required when binding the server to 0.0.0.0
# SECURECODE_TLS_CERT_FILE=/run/secrets/securecode_tls_cert
# SECURECODE_TLS_KEY_FILE=/run/secrets/securecode_tls_key

# Bootstrap authentication. Prefer protected files with mode 0600.
SECURECODE_BOOTSTRAP_TENANT_ID=local-tenant
# SECURECODE_BOOTSTRAP_ADMIN_TOKEN_FILE=/run/secrets/admin_token
# SECURECODE_BOOTSTRAP_WORKER_TOKEN_FILE=/run/secrets/worker_token
# SECURECODE_BOOTSTRAP_WORKER_REPOSITORIES=group/project
# SECURECODE_BOOTSTRAP_SCM_TOKEN_FILE=/run/secrets/securecode_scm_token

# Connected worker
SECURECODE_CONTROL_PLANE_URL=https://securecode-server:8080
SECURECODE_WORKER_ID=worker-01
SECURECODE_WORKER_TARGET=/workspace
# SECURECODE_WORKER_TOKEN_FILE=/run/secrets/worker_token
# SECURECODE_WORKER_ARTIFACT_HOSTS=securecode-server
SECURECODE_WORKER_REQUEST_TIMEOUT_SECONDS=15
SECURECODE_WORKER_POLL_SECONDS=2
SECURECODE_WORKER_MAX_BACKOFF_SECONDS=30

# SCM integrations. Configure one provider or both. Tokens and webhook secrets
# must be mounted as files and must never be committed.
# SECURECODE_SCM_TENANT_ID=local-tenant
# SECURECODE_SCM_PINS_FILE=/run/secrets/securecode_scm_pins.json
# SECURECODE_GITHUB_API_URL=https://api.github.com
# SECURECODE_GITHUB_INSTALLATION_ID=<installation-id>
# SECURECODE_GITHUB_TOKEN_FILE=/run/secrets/github_token
# SECURECODE_GITHUB_WEBHOOK_SECRET_FILE=/run/secrets/github_webhook_secret
# SECURECODE_GITLAB_API_URL=https://gitlab.example.com/api/v4
# SECURECODE_GITLAB_TOKEN_FILE=/run/secrets/gitlab_token
# SECURECODE_GITLAB_WEBHOOK_SECRET_FILE=/run/secrets/gitlab_webhook_secret

# Optional public benchmark provider. Never send private workplace source.
# DEEPSEEK_API_KEY=<public-benchmark-only-key>
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=<model-id>
# DEEPSEEK_BENCHMARK_BUDGET_USD=50

# securecode analyze --provider openai-compatible: any HTTPS endpoint with the OpenAI
# Chat Completions API. The audited code is sent there (D-118).
# SECURECODE_MODEL_BASE_URL=https://api.openai.com/v1
# SECURECODE_MODEL=<model-id>
# SECURECODE_MODEL_API_KEY=<key>
# SECURECODE_MODEL_PRICE_INPUT=<USD per million input tokens>
# SECURECODE_MODEL_PRICE_OUTPUT=<USD per million output tokens>
# SECURECODE_MODEL_CONTEXT_TOKENS=128000
# SECURECODE_MODEL_MAX_OUTPUT_TOKENS=16384
# SECURECODE_MODEL_REASONING_EFFORT=default
